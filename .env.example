# این فایل را کپی کنید به نام ‎.env‎ (در ویندوز: راست‌کلیک → Rename).
# فایل ‎.env‎ در گیت ذخیره نمی‌شود (در ‎.gitignore‎ هست) پس کلیدتان محفوظ می‌ماند.
# بدون این فایل هم برنامه اجرا می‌شود؛ فقط جستجوی فیلم نیازمند کلید TMDB است.

# --- ضروری برای جستجوی فیلم/سریال ---
# کلید TMDB (رایگان: https://www.themoviedb.org/settings/api)
# یا بعداً از داخل خود برنامه: صفحهٔ «تنظیمات»
NEXT_PUBLIC_TMDB_API_KEY=

# --- اختیاری: نمره‌های IMDb / Rotten Tomatoes / Metacritic ---
# کلید OMDb (رایگان: https://www.omdbapi.com/apikey.aspx) — ۱۰۰۰ درخواست در روز
# یا از داخل صفحهٔ «تنظیمات» وارد کنید
OMDB_API_KEY=

# --- اختیاری ---
# پخش‌کننده دلخواه برای ویدیوهای محلی (خالی = پخش‌کننده پیش‌فرض ویندوز)
# مثال: CINEPHILE_PLAYER=C:\Program Files\PotPlayer\PotPlayerMini64.exe
CINEPHILE_PLAYER=

# آدرسِ سایتِ فیلم (خالی = https://f2mc.top پیش‌فرض برنامه)
# سایتِ فیلم چند بار دامنه عوض کرده: f2medx.top → f2m.top → f2mc.top
# اگه روزی سایت دوباره جابجا شد، اینجا آدرس جدید رو وارد کن — بدون نیاز به آپدیتِ کد.
# مثال: F2M_BASE=https://f2mc.top
F2M_BASE=
