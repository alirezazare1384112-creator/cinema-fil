{
  "name": "cinephile-vault",
  "version": "1.0.0",
  "private": true,
  "description": "Personal movie/TV tracker with local media library, fan-edit gallery, and quotes collector — runs fully on your own computer.",
  "license": "MIT",
  "author": "Alireza Zare <https://github.com/alirezazare1384112-creator>",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/alirezazare1384112-creator/cinema-fil.git"
  },
  "homepage": "https://github.com/alirezazare1384112-creator/cinema-fil#readme",
  "bugs": {
    "url": "https://github.com/alirezazare1384112-creator/cinema-fil/issues"
  },
  "keywords": [
    "movie",
    "tv",
    "tmdb",
    "media-library",
    "personal-media",
    "nextjs",
    "prisma",
    "sqlite",
    "electron",
    "desktop-app"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "electron:dev": "concurrently -k -n next,electron -c green,cyan \"npm run dev\" \"wait-on http://127.0.0.1:3000 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && electron-builder --config electron-builder.yml",
    "electron:dist": "npm run build && electron-builder --publish never --config electron-builder.yml",
    "electron:pack": "npm run build && electron-builder --win dir --publish never --config electron-builder.yml"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "cross-env": "^10.0.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.alirezazare.cinephilevault",
    "productName": "Cinephile Vault",
    "copyright": "Copyright (c) 2026 Alireza Zare",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "package.json",
      "!**/.env",
      "!**/.env.*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md,readme,readme.txt,README,readme!md}",
      "!**/node_modules/**/{test,__tests__,tests,docs,doc,*.markdown,*.md,*.ts,*.flow,*.tsbuildinfo,.bin}",
      "!**/node_modules/**/{LICENSE,LICENCE,license,licence,BSD,GPL,MIT,UNLICENSE}",
      "!**/{.DS_Store,.git,.gitignore,.vscode,.idea,docs,doc,tests,test,coverage,*.log,CHANGELOG.md,README.md}"
    ],
    "extraResources": [
      { "from": ".next/standalone", "to": "app/.next/standalone", "filter": ["**/*"] },
      { "from": ".next/static", "to": "app/.next/static", "filter": ["**/*"] },
      { "from": "public", "to": "app/public", "filter": ["**/*"] },
      { "from": "prisma", "to": "app/prisma", "filter": ["**/*", "!dev.db", "!dev.db-journal"] },
      { "from": "prisma.config.ts", "to": "app/prisma.config.ts" }
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "CinephileVault-${version}-Setup.${ext}",
      "publisherName": "Alireza Zare",
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cinephile Vault",
      "menuCategory": "Cinephile",
      "license": "LICENSE",
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "Cinephile Vault"
    },
    "publish": {
      "provider": "github",
      "owner": "alirezazare1384112-creator",
      "repo": "cinema-fil",
      "releaseType": "release"
    }
  }
}
