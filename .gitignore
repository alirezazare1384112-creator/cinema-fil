# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
# Ignore build/ contents by default, but keep icons for electron-builder
/build/*
!/build/icon.ico
!/build/icon.png
!/build/icon.svg

# Electron packaging output — never commit (large .exe files)
/dist-electron/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# user uploads (large media files)
/uploads

# کش پوسترها (بهینه‌سازی سرعت)
.tmdb-image-cache/

# کش صفحات سایت فیلم (بهینه‌سازی سرعت)
.f2m-cache/

# دیتابیس محلی (دادهٔ شخصی — هرگز روی گیت‌هاب نرود)
dev.db
prisma/dev.db
dev.db-journal
*.db-journal
dev.db.bak-*

# کش تصاویر سایت فیلم (پروکسی پوسترها)
.f2m-image-cache/

# پشتیبان دیتابیس قبل از تغییر اسکیما
*.db.bak-*

# لاگ‌ها و اسکریپت‌های موقت دیباگ
*.log
_*.mjs
pot*out.txt
playout.txt
