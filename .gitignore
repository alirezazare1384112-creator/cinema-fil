# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# user uploads (large media files)
/uploads

# کش پوسترها (بهینه‌سازی سرعت)
.tmdb-image-cache/

# کش صفحات سایت فیلم (بهینه‌سازی سرعت)
.f2m-cache/

# کش تصاویر سایت فیلم (پروکسی پوسترها)
.f2m-image-cache/

# پشتیبان دیتابیس قبل از تغییر اسکیما
*.db.bak-*

# لاگ‌ها و اسکریپت‌های موقت دیباگ
*.log
_*.mjs
pot*out.txt
playout.txt
